NODE_ENV=development
PORT=5000

# PostgreSQL connection (local or Supabase)
# Local: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sams_db
# Supabase: DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sams_db
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@sams.local

# Zoom (Meeting SDK / LMS live classes)
ZOOM_SDK_CLIENT_ID=
ZOOM_SDK_CLIENT_SECRET=
# Access page "Secret token" (used to verify Zoom event/webhook notifications)
ZOOM_WEBHOOK_SECRET_TOKEN=
